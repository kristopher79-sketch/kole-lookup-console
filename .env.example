# Add this server-side SharePoint list ID to the existing local .env and Render environment.
SERVICE_LOCATION_NOTES_LIST_ID=

# Optional override for the read-only Engine Photo Library integration.
# Defaults to the verified Engine Photo Library list ID when left blank.
PHOTO_LIBRARY_LIST_ID=

# Optional override for the Photo Reference Overrides SharePoint list.
PHOTO_LIBRARY_OVERRIDES_LIST_ID=

# Required for hide/restore controls. Use a separate strong secret from lookup access.
PHOTO_LIBRARY_CURATOR_TOKEN=

# Existing optional override. Leave unset to discover the exact "Service Locations" display name.
SERVICE_LOCATIONS_LIST_ID=

# Optional override. Leave unset to discover the exact "Check In Times" display name.
CHECK_IN_TIMES_LIST_ID=

# Optional override. Defaults to the verified "Operator Rate Texts" list ID.
OPERATOR_RATE_TEXTS_LIST_ID=

# Optional override. Leave unset to discover the "Load Paperwork" folder in the Dispatch OneDrive root.
LOAD_PAPERWORK_FOLDER_ID=

# KOLE Track uses the existing KOLE Auto Updater list and defaults to the Passkey internal field name.
KOLE_TRACK_PASSKEY_FIELD=Passkey

# Optional dedicated signing secret. When blank, KOLE Track reuses MOBILE_SESSION_SECRET.
KOLE_TRACK_SESSION_SECRET=

# Customer location refresh guidance, clamped by the API to 30-900 seconds.
KOLE_TRACK_REFRESH_SECONDS=60
